{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapass.local/schemas/contracts/architecture-view.schema.json",
  "title": "DataPass architecture-view envelope (0.1-draft)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "datapass.architecture-view"
    },
    "contractVersion": {
      "const": "0.1-draft"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "projectRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "scopeRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "manifestHash": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ]
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repoRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "workingTreeHash": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "algorithm",
                  "value"
                ]
              }
            },
            "required": [
              "repoRef",
              "revision",
              "workingTreeHash"
            ]
          },
          "maxItems": 30,
          "minItems": 0
        }
      },
      "required": [
        "scopeRevision",
        "manifestHash",
        "repositories"
      ]
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "recordRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "confidential"
            ]
          },
          "snapshotHash": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "const": "sha256"
              },
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "algorithm",
              "value"
            ]
          }
        },
        "required": [
          "id",
          "authority",
          "recordRef",
          "revision",
          "observedAt",
          "classification",
          "snapshotHash"
        ]
      },
      "maxItems": 100,
      "minItems": 0
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "layoutRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "mode": {
          "enum": [
            "active-engineering",
            "learning",
            "portfolio-reconstruction",
            "reference"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              },
              "itemRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                },
                "maxItems": 100,
                "minItems": 0
              },
              "state": {
                "enum": [
                  "planned",
                  "observed",
                  "unknown"
                ]
              }
            },
            "required": [
              "id",
              "itemRef",
              "label",
              "evidenceRefs",
              "state"
            ]
          },
          "maxItems": 200,
          "minItems": 0
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              },
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              },
              "relation": {
                "enum": [
                  "consumes",
                  "produces",
                  "runsOn",
                  "observedBy",
                  "dependsOn"
                ]
              }
            },
            "required": [
              "id",
              "source",
              "target",
              "relation"
            ]
          },
          "maxItems": 500,
          "minItems": 0
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 100,
          "minItems": 0
        },
        "publication": {
          "const": "not-authorized"
        }
      },
      "required": [
        "semanticRevision",
        "layoutRevision",
        "mode",
        "nodes",
        "edges",
        "omissions",
        "publication"
      ]
    }
  },
  "required": [
    "format",
    "contractVersion",
    "id",
    "projectRef",
    "scopeRef",
    "base",
    "classification",
    "createdAt",
    "sources",
    "payload"
  ]
}
