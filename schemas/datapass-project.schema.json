{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/julian-passebecq/datapass-vscode/schemas/datapass-project.schema.json",
  "title": "DataPass Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Modules this project uses. false switches a module off (hidden in Galaxy, Work and Links); unlisted modules stay on. Use \"DataPass: Choose Project Modules…\".",
      "properties": {
        "fabric": {
          "type": "boolean"
        },
        "databricks": {
          "type": "boolean"
        },
        "powerbi": {
          "type": "boolean"
        },
        "grafana": {
          "type": "boolean"
        },
        "infrastructure": {
          "type": "boolean"
        },
        "airflow": {
          "type": "boolean"
        },
        "mongoku": {
          "type": "boolean"
        },
        "diagramcloud": {
          "type": "boolean"
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "remote": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^(https://[^\\s@/]+/[^\\s]+|git@[A-Za-z0-9.-]+:[A-Za-z0-9._/-]+)$",
                "description": "https or git@host:path; never embed credentials."
              },
              "branch": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._/-]{1,200}$"
              }
            }
          },
          "management": {
            "enum": [
              "local",
              "remote-only"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "remote"
            ]
          }
        ]
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fabric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspaceName": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "toolboxRoot": {
              "type": "string"
            },
            "deployment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configPath": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Workspace-relative Fabric deployment config path. Defaults to .deploy/fabric.yml."
                },
                "repositoryDirectory": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Workspace-relative directory containing Fabric item definitions. Defaults to workspace root."
                },
                "targetEnvironment": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Optional environment name passed to fab deploy --target_env."
                }
              }
            }
          }
        },
        "databricks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bundleRoot": {
              "type": "string"
            },
            "defaultTarget": {
              "type": "string"
            }
          }
        },
        "grafana": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generatorCommand": {
              "type": "string"
            },
            "watchPath": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^(https://[^\\s/?#@]+(/[^\\s?#\\\\]*)?|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?(/[^\\s?#\\\\]*)?)$",
              "description": "Grafana stack base URL, e.g. https://<stack>.grafana.net/. https (or http://localhost); no credentials, query or #fragment. Navigation only: DataPass never checks sign-in or data freshness."
            },
            "dashboards": {
              "type": "array",
              "maxItems": 50,
              "description": "Dashboards to open from the Work view. Requires url.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "uid",
                  "title"
                ],
                "properties": {
                  "uid": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,40}$",
                    "description": "Grafana dashboard UID (opened as <url>/d/<uid>)."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Scope ids (or \"project\") this dashboard belongs to; omit for every scope."
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Workspace-relative dashboard-as-code file (Foundation SDK, JSON, …)."
                  }
                }
              }
            }
          }
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string"
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sshHost": {
              "type": "string",
              "description": "SSH config host alias only. Do not store credentials here."
            }
          }
        },
        "airflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "local-docker",
                "oci-k3s",
                "fabric-git-sync",
                "fabric-workspace-git",
                "managed-other"
              ]
            },
            "identity": {
              "type": "string"
            },
            "gitSyncRepo": {
              "type": "string"
            },
            "workspaceGitAlm": {
              "type": "boolean"
            }
          }
        },
        "powerbi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectRoot": {
              "type": "string",
              "description": "Folder containing the .pbip file(s)."
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "companions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional companion apps. Their addresses are user settings (datapass.mongoku.url); the manifest only maps stable ids.",
      "properties": {
        "mongoku": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "entityId"
              ]
            },
            {
              "required": [
                "scopeEntities"
              ]
            }
          ],
          "properties": {
            "entityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "description": "Mongoku entity id for the whole project, e.g. foil_project."
            },
            "scopeEntities": {
              "type": "object",
              "description": "Scope id (or \"project\") → Mongoku entity id, for scopes that map to a different entity.",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        }
      }
    },
    "scopes": {
      "type": "array",
      "description": "v2: work scopes. One is active per window; a scope focuses navigation and preflight, it does not sandbox tools.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "not": {
              "const": "project"
            },
            "description": "\"project\" is reserved for the whole-project scope."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string"
          },
          "itemRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            }
          },
          "capabilityRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Operation capability ids, e.g. fabric.notebook.local-sync."
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "capabilityRef": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "description": "v2: external applications (Streamlit, React…) exchanged with through contracts, not hosted by DataPass.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "appType",
          "repoRef"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string"
          },
          "appType": {
            "enum": [
              "streamlit",
              "react",
              "static-site",
              "api",
              "other"
            ]
          },
          "repoRef": {
            "type": "string",
            "description": "Key in repositories."
          },
          "entrypoint": {
            "type": "string"
          },
          "inputContracts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            }
          },
          "outputContracts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            }
          },
          "hosting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "domainPacks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(builtin:[a-z][a-z0-9.-]+|[^/\\\\~].*\\.json)$"
      },
      "description": "v2: builtin:<name> (e.g. builtin:foil.programme, builtin:sample.retail) or workspace-relative pack files."
    },
    "graph": {
      "type": "string",
      "description": "v2: workspace-relative path of the project graph (default .datapass/graph.json)."
    }
  },
  "description": "DataPass project manifest. schemaVersion 1 is the V2.1 format; schemaVersion 2 adds work scopes, apps, domain packs, the project graph path and remote-only repositories. Never put secrets in this file.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "repositories": {
            "additionalProperties": {
              "required": [
                "path"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "remote"
                    ]
                  },
                  {
                    "required": [
                      "management"
                    ]
                  }
                ]
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "scopes"
              ]
            },
            {
              "required": [
                "apps"
              ]
            },
            {
              "required": [
                "domainPacks"
              ]
            },
            {
              "required": [
                "graph"
              ]
            }
          ]
        }
      }
    }
  ]
}
