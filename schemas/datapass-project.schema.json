{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/julian-passebecq/datapass-vscode/schemas/datapass-project.schema.json",
  "title": "DataPass Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "description": "1: V2.1 format. 2: scopes, apps, packs, graph, remote-only repositories. 3 (DataPass V3): environments, project docs, planned repositories and a default repository per scope; pairs with graph version 0.2. 4: adds localEnv (env files and required variable names) and identifiers (explicitly non-secret ids)."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Modules this project uses. false switches a module off (hidden in Galaxy, Work and Links); unlisted modules stay on. Use \"DataPass: Choose Project Modules…\".",
      "properties": {
        "fabric": {
          "type": "boolean"
        },
        "databricks": {
          "type": "boolean"
        },
        "powerbi": {
          "type": "boolean"
        },
        "grafana": {
          "type": "boolean"
        },
        "infrastructure": {
          "type": "boolean"
        },
        "airflow": {
          "type": "boolean"
        },
        "mongoku": {
          "type": "boolean",
          "description": "Frozen: Mongoku reads this project's files (board.json, project.json) from GitHub and has no link with DataPass. New manifests set it to false."
        },
        "diagramcloud": {
          "type": "boolean"
        },
        "azure": {
          "type": "boolean",
          "description": "Azure data services: Data Factory, Functions, Storage, Cosmos DB."
        },
        "databases": {
          "type": "boolean",
          "description": "Databases as project destinations: MongoDB Atlas, PostgreSQL / Neon."
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "remote": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^(https://[^\\s@/]+/[^\\s]+|https://([A-Za-z0-9][A-Za-z0-9._-]*)@dev\\.azure\\.com/\\2/[^\\s]+|git@[A-Za-z0-9.-]+:[A-Za-z0-9._%/-]+|([A-Za-z0-9][A-Za-z0-9._-]*)@vs-ssh\\.visualstudio\\.com:v3/\\3/[A-Za-z0-9._%/-]+)$",
                "description": "https or git@host:path; never embed credentials. Azure DevOps: the address its Clone button copies (https://<organization>@dev.azure.com/<organization>/<project>/_git/<repo>) and its SSH address (git@ssh.dev.azure.com:v3/<organization>/<project>/<repo>) are accepted and name the same repository."
              },
              "branch": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._/-]{1,200}$"
              }
            }
          },
          "management": {
            "enum": [
              "local",
              "remote-only"
            ]
          },
          "planned": {
            "const": true,
            "description": "v3: this repository does not exist yet (to be created). Operations that need its files stay blocked."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "v3: what lives in this repository (shown to people and in AI context)."
          }
        },
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "remote"
            ]
          },
          {
            "required": [
              "planned"
            ]
          }
        ],
        "not": {
          "required": [
            "planned",
            "path"
          ]
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fabric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspaceName": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "toolboxRoot": {
              "type": "string"
            },
            "deployment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configPath": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Workspace-relative Fabric deployment config path. Defaults to .deploy/fabric.yml."
                },
                "repositoryDirectory": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Workspace-relative directory containing Fabric item definitions. Defaults to workspace root."
                },
                "targetEnvironment": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Optional environment name passed to fab deploy --target_env."
                }
              }
            }
          }
        },
        "databricks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bundleRoot": {
              "type": "string"
            },
            "defaultTarget": {
              "type": "string"
            }
          }
        },
        "grafana": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generatorCommand": {
              "type": "string"
            },
            "watchPath": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^(https://[^\\s/?#@]+(/[^\\s?#\\\\]*)?|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?(/[^\\s?#\\\\]*)?)$",
              "description": "Grafana stack base URL, e.g. https://<stack>.grafana.net/. https (or http://localhost); no credentials, query or #fragment. Navigation only: DataPass never checks sign-in or data freshness."
            },
            "dashboards": {
              "type": "array",
              "maxItems": 50,
              "description": "Dashboards to open from the Work view. Requires url.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "uid",
                  "title"
                ],
                "properties": {
                  "uid": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,40}$",
                    "description": "Grafana dashboard UID (opened as <url>/d/<uid>)."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Scope ids (or \"project\") this dashboard belongs to; omit for every scope."
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Workspace-relative dashboard-as-code file (Foundation SDK, JSON, …)."
                  }
                }
              }
            }
          }
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string"
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sshHost": {
              "type": "string",
              "description": "SSH config host alias only. Do not store credentials here."
            }
          }
        },
        "airflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "local-docker",
                "oci-k3s",
                "fabric-git-sync",
                "fabric-workspace-git",
                "managed-other"
              ]
            },
            "identity": {
              "type": "string"
            },
            "gitSyncRepo": {
              "type": "string"
            },
            "workspaceGitAlm": {
              "type": "boolean"
            }
          }
        },
        "powerbi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectRoot": {
              "type": "string",
              "description": "Folder containing the .pbip file(s)."
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "companions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional companion apps. Their addresses are user settings (datapass.mongoku.url); the manifest only maps stable ids.",
      "properties": {
        "mongoku": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "entityId"
              ]
            },
            {
              "required": [
                "scopeEntities"
              ]
            }
          ],
          "properties": {
            "entityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "description": "Mongoku entity id for the whole project, e.g. foil_project."
            },
            "scopeEntities": {
              "type": "object",
              "description": "Scope id (or \"project\") → Mongoku entity id, for scopes that map to a different entity.",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        }
      }
    },
    "scopes": {
      "type": "array",
      "description": "v2: work scopes. One is active per window; a scope focuses navigation and preflight, it does not sandbox tools.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "not": {
              "const": "project"
            },
            "description": "\"project\" is reserved for the whole-project scope."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string"
          },
          "itemRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            }
          },
          "capabilityRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Operation capability ids, e.g. fabric.notebook.local-sync."
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "capabilityRef": {
                  "type": "string"
                }
              }
            }
          },
          "repoRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "description": "v3: default repository of this scope (sub-project); components without their own repoRef use it."
          },
          "docs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$",
                  "description": "Path relative to the repository root. No absolute paths, no .. segments."
                },
                "repoRef": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                  "description": "Repository key; omitted = the repository holding this manifest."
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://[^\\s]+$"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "path"
                  ],
                  "not": {
                    "required": [
                      "url"
                    ]
                  }
                },
                {
                  "required": [
                    "url"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "path"
                        ]
                      },
                      {
                        "required": [
                          "repoRef"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "description": "v3: documentation of this scope."
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "description": "v2: external applications (Streamlit, React…) exchanged with through contracts, not hosted by DataPass.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "appType",
          "repoRef"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string"
          },
          "appType": {
            "enum": [
              "streamlit",
              "react",
              "static-site",
              "api",
              "other"
            ]
          },
          "repoRef": {
            "type": "string",
            "description": "Key in repositories."
          },
          "entrypoint": {
            "type": "string"
          },
          "inputContracts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            }
          },
          "outputContracts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            }
          },
          "hosting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "domainPacks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(builtin:[a-z][a-z0-9.-]+|[^/\\\\~].*\\.json)$"
      },
      "description": "v2: builtin:<name> (e.g. builtin:foil.programme, builtin:sample.retail) or workspace-relative pack files."
    },
    "graph": {
      "type": "string",
      "description": "v2: workspace-relative path of the project graph (default .datapass/graph.json)."
    },
    "resources": {
      "type": "array",
      "maxItems": 50,
      "description": "v2: shared resources, declared once (a VM, container host, cluster). Never credentials.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "kind": {
            "enum": [
              "vm",
              "container-host",
              "kubernetes-cluster",
              "database",
              "workspace",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "provider": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 ._-]{1,40}$"
          },
          "ssh": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
                "description": "Alias from your ~/.ssh/config. No user@, port or key."
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 200,
      "description": "v2: how a workload/scope uses a resource. Env lists variable NAMES only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resource"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "folder": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._/@+-]{0,299}$",
            "description": "Absolute folder on the host."
          },
          "repository": {
            "type": "string"
          },
          "compose": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "processes": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,59}$"
            }
          }
        }
      }
    },
    "$schema": {
      "type": "string",
      "description": "Optional URL of this JSON Schema, for editors and AI tools that validate the file."
    },
    "environments": {
      "type": "array",
      "maxItems": 20,
      "description": "v3: deployment environments (dev, test, prod…). Component operations name one; a review confirmed for one environment never applies to another. Names only, never credentials.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "production": {
            "type": "boolean",
            "description": "true for environments where mistakes affect real users or data."
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "docs": {
      "type": "array",
      "maxItems": 50,
      "description": "v3: project documentation to open from DataPass (architecture notes, AGENTS.md…).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$",
            "description": "Path relative to the repository root. No absolute paths, no .. segments."
          },
          "repoRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "description": "Repository key; omitted = the repository holding this manifest."
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "oneOf": [
          {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "url"
              ]
            }
          },
          {
            "required": [
              "url"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "repoRef"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "localEnv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "description": "v4: local env files a developer needs and the variable NAMES the project requires. Never values: DataPass only checks which names are present, and tells you to fetch secrets from your local vault (Power Ops).",
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "description": "Env files, relative to the repository (default: the one holding this manifest). Only .env, .env.<name>, <name>.env and .dev.vars files are accepted.",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "pattern": "^(?:.*/)?(?:\\.env(?:\\.[A-Za-z0-9_-]+)*|[A-Za-z0-9_-]+\\.env|\\.dev\\.vars(?:\\.[A-Za-z0-9_-]+)*)$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^(?:.*/)?(?:\\.env(?:\\.[A-Za-z0-9_-]+)*|[A-Za-z0-9_-]+\\.env|\\.dev\\.vars(?:\\.[A-Za-z0-9_-]+)*)$"
                  },
                  "repoRef": {
                    "type": "string",
                    "description": "Repository key; omitted = the repository holding this manifest."
                  },
                  "optional": {
                    "type": "boolean",
                    "description": "true for files such as .env.local that may be absent."
                  }
                }
              }
            ]
          }
        },
        "requiredKeys": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "description": "Variable names the project needs, e.g. CLOUDFLARE_ACCOUNT_ID. Names only.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        }
      }
    },
    "identifiers": {
      "type": "array",
      "maxItems": 50,
      "description": "v4: explicitly non-secret identifiers (account, subscription, workspace or project ids) DataPass may show and copy. Never secrets, tokens, passwords, keys or URLs: those stay in your local vault (Power Ops).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "description": "The non-secret id itself."
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "description": "e.g. cloudflare, azure, databricks."
          },
          "envKey": {
            "type": "string",
