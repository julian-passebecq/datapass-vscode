{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapass.local/schemas/datapass-tours.schema.json",
  "title": "DataPass journey tours (datapass.tours/1)",
  "description": "User and AI-proposed tours in .datapass/tours.json. Built-in tours are generated from facts and never written here (origin 'generated' is refused).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "tours"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 200 },
    "format": { "const": "datapass.tours" },
    "version": { "const": 1 },
    "tours": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/tour" }
    }
  },
  "$defs": {
    "tour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "journey", "origin", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "journey": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Journey key; its display name is the setting datapass.tours.journeyLabels." },
        "origin": { "enum": ["ai-proposed", "user"], "description": "ai-proposed = produced through the AI exchange and shown marked; user = written by a person." },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "viewId": { "type": "string", "minLength": 1, "maxLength": 128, "description": "A view the Location offers (catalog id); ignored when not offered." },
        "text": { "type": "string", "maxLength": 280 }
      }
    },
    "location": {
      "description": "A NavLocation (view-spi datapass.nav-location/1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "nodeId", "artifactKind"],
      "properties": {
        "level": { "enum": ["project", "subproject", "artifact", "step", "operation"] },
        "nodeId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "artifactKind": { "type": "string", "pattern": "^(?:\\*|[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?)$" }
      }
    }
  }
}
