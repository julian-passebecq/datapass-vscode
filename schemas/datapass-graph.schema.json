{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapass.local/schemas/datapass-graph.schema.json",
  "title": "DataPass project graph (0.1-draft)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "datapass.graph"
    },
    "version": {
      "const": "0.1-draft"
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "kind": {
            "enum": [
              "notebook",
              "workflow",
              "dataflow",
              "streaming-flow",
              "script",
              "package",
              "dataset",
              "dataset-snapshot",
              "application",
              "dashboard",
              "semantic-model",
              "infrastructure-definition",
              "domain-config",
              "artifact-bundle",
              "report",
              "model",
              "resource",
              "study",
              "question",
              "decision"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "nativeType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 20,
            "minItems": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 30,
            "minItems": 0
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "repoRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^(?![/\\\\~])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "confidential"
            ]
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "kind",
          "label"
        ]
      },
      "maxItems": 2000,
      "minItems": 0
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "itemRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                },
                "facets": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                      },
                      "maxItems": 50,
                      "minItems": 1
                    },
                    {
                      "const": "*"
                    }
                  ]
                }
              },
              "required": [
                "ref",
                "facets"
              ]
            },
            "maxItems": 50,
            "minItems": 0
          },
          "producedFrom": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "relation": {
            "enum": [
              "contains",
              "uses",
              "produces",
              "consumes",
              "runsOn",
              "deployedFrom",
              "observedBy",
              "derivedFrom",
              "supersedes",
              "dependsOn",
              "invokes"
            ]
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "relation"
        ]
      },
      "maxItems": 5000,
      "minItems": 0
    }
  },
  "required": [
    "format",
    "version",
    "items"
  ]
}
