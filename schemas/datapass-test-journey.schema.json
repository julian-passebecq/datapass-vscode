{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapass.local/schemas/datapass-test-journey.schema.json",
  "title": "DataPass test journey (1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "format": {
      "const": "datapass.test-journey"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20,
      "pattern": "^[A-Z][A-Z0-9-]{1,19}$"
    },
    "kind": {
      "enum": [
        "app",
        "client"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "as": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "mode": {
          "enum": [
            "Vanilla",
            "Standard",
            "DataPass",
            "Advanced"
          ]
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9_-]{0,39}$"
        },
        "trust": {
          "enum": [
            "trusted",
            "restricted"
          ]
        },
        "open": {
          "enum": [
            "workspace",
            "fixture",
            "empty"
          ]
        },
        "fixture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}(/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}){0,11}$"
        }
      },
      "required": []
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 10,
      "minItems": 0
    },
    "expected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 20,
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 20,
      "minItems": 0
    },
    "features": {
      "type": "array",
      "items": {
        "enum": [
          "onboarding",
          "workspace",
          "architecture",
          "variants",
          "options",
          "costs",
          "readiness",
          "evidence",
          "work-orders",
          "stamps",
          "file-context",
          "ai-exchange",
          "resources",
          "git",
          "format-checks",
          "modes",
          "file-versions",
          "toolkit",
          "mcp",
          "install",
          "docs",
          "performance"
        ]
      },
      "maxItems": 20,
      "minItems": 1
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 10,
      "minItems": 0
    },
    "ui": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "run": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "run"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "openView": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "openView"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "click": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "role": {
                "enum": [
                  "button",
                  "link",
                  "tab",
                  "treeitem",
                  "menuitem",
                  "checkbox",
                  "option"
                ]
              }
            },
            "required": [
              "click"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 120000
              }
            },
            "required": [
              "expect"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expectAbsent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 120000
              }
            },
            "required": [
              "expectAbsent"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "press": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[A-Za-z0-9]+(\\+[A-Za-z0-9]+){0,3}$"
              }
            },
            "required": [
              "press"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "screenshot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
              }
            },
            "required": [
              "screenshot"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quickPick": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "quickPick"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "wait": {
                "type": "integer",
                "minimum": 100,
                "maximum": 120000
              }
            },
            "required": [
              "wait"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "commandPaletteSearch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "commandPaletteSearch"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "settingsSearch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "settingsSearch"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "openFile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "pattern": "^(?!(.*/)?\\.\\.(/|$))[A-Za-z0-9_.][A-Za-z0-9_.-]{0,99}(/[A-Za-z0-9_.][A-Za-z0-9_.-]{0,99}){0,11}$"
              }
            },
            "required": [
              "openFile"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chooseFolder": {
                "enum": [
                  "scratch",
                  "fixture"
                ]
              }
            },
            "required": [
              "chooseFolder"
            ]
          }
        ]
      },
      "maxItems": 40,
      "minItems": 1
    },
    "notAutomatable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "kind",
    "title",
    "goal",
    "expected",
    "features"
  ]
}
