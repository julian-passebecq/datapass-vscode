{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapass.local/schemas/datapass-links.schema.json",
  "title": "DataPass project links (1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500
    },
    "format": {
      "const": "datapass.links"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "url": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 2000,
                  "pattern": "^https?://\\S+$"
                },
                "kind": {
                  "enum": [
                    "dashboard",
                    "workspace",
                    "portal",
                    "repository",
                    "docs",
                    "other"
                  ]
                },
                "environment": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "label",
                "url",
                "kind"
              ]
            },
            "maxItems": 60,
            "minItems": 1
          }
        },
        "required": [
          "title",
          "links"
        ]
      },
      "maxItems": 30,
      "minItems": 0
    }
  },
  "required": [
    "format",
    "version",
    "groups"
  ]
}
