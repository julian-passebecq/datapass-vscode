{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapass.local/schemas/datapass-sheet.schema.json",
  "title": "DataPass project sheet (1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500
    },
    "format": {
      "const": "datapass.sheet"
    },
    "version": {
      "const": "1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "componentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "kind": {
            "enum": [
              "table",
              "collection",
              "files",
              "view",
              "stream",
              "index",
              "other"
            ]
          },
          "rows": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "size": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "files": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "growth": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "refresh": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "asOf": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "role": {
                  "enum": [
                    "key",
                    "foreign-key",
                    "partition",
                    "time",
                    "measure",
                    "dimension",
                    "text",
                    "vector",
                    "important"
                  ]
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "name"
              ]
            },
            "maxItems": 100,
            "minItems": 0
          },
          "producedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 20,
            "minItems": 0
          },
          "consumedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 20,
            "minItems": 0
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "confidential"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "maxItems": 200,
      "minItems": 0
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "symbol"
              ]
            },
            "maxItems": 60,
            "minItems": 0
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": []
          },
          "componentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "where": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repoRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "path"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reference": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://\\S+$"
          },
          "validation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "label",
          "expression"
        ]
      },
      "maxItems": 200,
      "minItems": 0
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "componentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "specs": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "os": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 50,
            "minItems": 0
          },
          "access": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "cost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "decisionRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "maxItems": 50,
      "minItems": 0
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "term",
          "meaning"
        ]
      },
      "maxItems": 200,
      "minItems": 0
    }
  },
  "required": [
    "format",
    "version"
  ]
}
