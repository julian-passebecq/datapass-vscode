{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datapass.local/schemas/datapass-domain-pack.schema.json",
  "title": "DataPass domain pack (0.1-draft)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "datapass.domain-pack"
    },
    "packVersion": {
      "const": "0.1-draft"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "mappingStatus": {
      "enum": [
        "reviewed",
        "draft-awaiting-owner-declaration",
        "synthetic-example"
      ]
    },
    "acceptedSchemas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 20,
      "minItems": 0
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "itemKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 30,
            "minItems": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 30,
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "maxItems": 20,
      "minItems": 0
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pointers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(/([^~/]|~[01])*)*$",
              "maxLength": 400
            },
            "maxItems": 50,
            "minItems": 1
          },
          "help": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "label",
          "pointers"
        ]
      },
      "maxItems": 50,
      "minItems": 0
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "schemaRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pointer": {
                        "type": "string",
                        "pattern": "^(/([^~/]|~[01])*)*$",
                        "maxLength": 400
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "role": {
                        "enum": [
                          "reference",
                          "assumption",
                          "computed",
                          "proposal",
                          "unsupported"
                        ]
                      },
                      "type": {
                        "enum": [
                          "number",
                          "integer",
                          "string",
                          "boolean",
                          "enum"
                        ]
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "maxItems": 50,
                        "minItems": 0
                      },
                      "help": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "facet": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                      },
                      "coupledToModel": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "pointer",
                      "label",
                      "role",
                      "type"
                    ]
                  },
                  "maxItems": 100,
                  "minItems": 0
                }
              },
              "required": [
                "id",
                "title",
                "fields"
              ]
            },
            "maxItems": 30,
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "schemaRef",
          "groups"
        ]
      },
      "maxItems": 20,
      "minItems": 0
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "view": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "producer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                },
                "facets": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
                      },
                      "maxItems": 50,
                      "minItems": 1
                    },
                    {
                      "const": "*"
                    }
                  ]
                }
              },
              "required": [
                "ref",
                "facets"
              ]
            },
            "maxItems": 30,
            "minItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "dependsOn"
        ]
      },
      "maxItems": 100,
      "minItems": 0
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "external-kernel",
              "native-tool",
              "manual-review"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "capabilityRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "owner"
        ]
      },
      "maxItems": 20,
      "minItems": 0
    },
    "briefTemplates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "audience": {
            "enum": [
              "internal",
              "named-reviewers",
              "public"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 30,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "audience",
          "sections"
        ]
      },
      "maxItems": 20,
      "minItems": 0
    },
    "moneyKinds": {
      "type": "array",
      "items": {
        "enum": [
          "unit-capex-assumption",
          "programme-budget",
          "funding-target",
          "funding-requested",
          "funding-committed",
          "funding-received",
          "cloud-spend",
          "other"
        ]
      },
      "maxItems": 10,
      "minItems": 0
    }
  },
  "required": [
    "format",
    "packVersion",
    "namespace",
    "version",
    "title",
    "mappingStatus",
    "views",
    "facets",
    "outputs"
  ]
}
