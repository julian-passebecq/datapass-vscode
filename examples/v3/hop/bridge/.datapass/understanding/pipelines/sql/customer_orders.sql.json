    { "id": "lines-products", "step": "products", "left": "sales.order_lines o", "right": "catalog.products p", "type": "left", "keys": [["o.product_id", "p.product_id"]], "note": "Only the current product version (p.valid_to IS NULL).", "provenance": "declared" }
  ]
