  "title": "Sites over their contract",
  "summary": "The last 30 days per site, only for sites whose peak demand went over their contract at least once. The filter is a semi-join: it keeps matching rows without adding columns or duplicating them.",
  "component": "models",
  "steps": [
    { "id": "fact", "title": "Daily energy fact", "kind": "source", "lines": [12, 12], "inputs": ["gold.fct_site_energy_daily"], "outputs": ["f"], "provenance": "declared" },
    { "id": "site", "title": "Join the site", "kind": "join", "lines": [13, 14], "inputs": ["f", "gold.dim_site"], "outputs": ["f + s"], "provenance": "declared" },
    { "id": "breaches", "title": "Sites that breached once", "kind": "filter", "lines": [16, 19], "inputs": ["gold.fct_site_energy_daily"], "outputs": ["breaches"], "note": "Any day, not only the last 30.", "provenance": "declared" },
    { "id": "semi", "title": "Keep only those sites", "kind": "join", "lines": [15, 21], "inputs": ["f + s", "breaches"], "outputs": ["f + s (filtered)"], "provenance": "declared" },
    { "id": "where", "title": "Last 30 days", "kind": "filter", "lines": [22, 22], "provenance": "declared" },
    { "id": "aggregate", "title": "One row per site", "kind": "aggregate", "lines": [4, 11], "columns": [
      { "name": "max_demand_kw", "from": ["f.peak_demand_kw"], "note": "max" },
      { "name": "kwh_30d", "from": ["f.kwh_total"], "note": "sum" },
      { "name": "days_over", "from": ["f.peak_demand_kw", "f.contract_kw"], "note": "days above the contract" }
    ], "provenance": "declared" },
    { "id": "group", "title": "Grouped by site", "kind": "aggregate", "lines": [23, 23], "provenance": "declared" },
    { "id": "write", "title": "Replace the report view", "kind": "write", "lines": [3, 3], "outputs": ["gold.rpt_sites_over_contract"], "provenance": "declared" }
  ],
  "links": [
    { "from": "fact", "to": "site", "kind": "data" },
