    { "id": "fact-breaches", "step": "semi", "left": "gold.fct_site_energy_daily f", "right": "breaches", "type": "semi", "keys": [["f.site_id", "breaches.site_id"]], "note": "LEFT SEMI JOIN, the same as WHERE f.site_id IN (SELECT site_id FROM breaches).", "provenance": "declared" }
