{
  // The native test of each component: a task in the "test" group that runs in the component's
  // folder. DataPass's *Run Component Test* finds it, shows it and runs it only when you confirm.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test PDF processing",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest", "-v"],
      "options": { "cwd": "${workspaceFolder}/processing" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
