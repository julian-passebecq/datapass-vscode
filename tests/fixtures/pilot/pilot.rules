# Written by DataPass for the pilot order wo-20260926-2105-1234 (stage 1, read-only). Do not edit.
# allow: runs outside the read-only sandbox (it needs the network). forbidden: blocked.
# Every other command runs in the read-only sandbox, without network, or asks you first.
# Not allowed on purpose (asks): func azure functionapp logstream.

prefix_rule(
    pattern = ["az", "version"],
    decision = "allow",
    justification = "DataPass pilot stage 1: read-only",
    match = ["az version"],
    not_match = ["az delete-me"],
)

