  "blocks": [
    {
      "id": "sql-quality",
      "title": "Row-level validation",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "code",
      "language": "sql",
      "code": "SELECT wbs_code, activity_name, start_date, finish_date,\n       forecast_cost_eur\nFROM staging_schedule\nWHERE wbs_code IS NULL\n   OR start_date IS NULL\n   OR finish_date IS NULL\n   OR forecast_cost_eur IS NULL\n   OR start_date > finish_date\n   OR forecast_cost_eur < 0;"
    },
    {
      "id": "schedule-input",
      "title": "Synthetic input",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "table",
      "columns": [
        "WBS",
        "Activity",
        "Start",
        "Finish",
        "Cost EUR"
      ],
      "rows": [
        [
          "wbs-01",
          "Site preparation",
          "2026-01-10",
          "2026-01-31",
          120000
        ],
        [
          "wbs-02",
          "Drilling",
          "2026-03-20",
          "2026-03-01",
          420000
        ],
        [
          "wbs-03",
          "Commissioning",
          "2026-07-01",
          "2026-07-15",
          -1000
        ]
      ]
    },
    {
      "id": "schedule-errors",
      "title": "Expected exceptions",
      "visibility": "public",
      "sourceIds": [],
      "provenance": "synthetic",
      "type": "table",
      "columns": [
        "WBS",
        "Reason"
      ],
      "rows": [
        [
          "wbs-02",
          "Start occurs after finish"
        ],
        [
          "wbs-03",
          "Negative forecast cost"
        ]
