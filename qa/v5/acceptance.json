      "notes": ["Steps drafted against the !218/!220 labels; the first run after they merge confirms them."],
      "journeys": [
        {
          "id": "V5-01", "kind": "main", "title": "Materialize fct_orders, detach it, edit both sides, re-attach as a proposal", "fixture": "shop",
