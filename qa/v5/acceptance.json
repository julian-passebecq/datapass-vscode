            {"expect": "notebook edited", "timeoutMs": 20000},
            {"appendFile": "dbt/models/marts/fct_orders.sql", "text": "\n-- edited in dbt\n"},
            {"expect": "both", "timeoutMs": 20000},
            {"expectAbsent": "in sync"},
            {"shot": "v5-03-drift-both"},
            {"run": "DataPass: Detach dbt Model (the notebook becomes the authority)"},
            {"quickPick": "fct_orders"},
            {"quickPick": "Re-attach"},
            {"expect": "re-attach proposed", "timeoutMs": 20000},
            {"expectNoFile": "^\\.git/refs/heads/datapass"}
