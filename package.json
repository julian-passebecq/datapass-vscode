      "view/item/context": [
        {
          "command": "datapass.openComponentEntry",
          "when": "view == datapass.project && viewItem =~ /^component.*\\.entry/",
          "group": "inline@1"
        },
        {
          "command": "datapass.preparationPack",
          "when": "view == datapass.project && viewItem =~ /^(component|subproject)/",
          "group": "inline@2"
        },
        {
          "command": "datapass.openComponentFolder",
          "when": "view == datapass.project && viewItem =~ /^component\\.local/",
          "group": "1_open@1"
        },
        {
          "command": "datapass.openNativeTool",
          "when": "view == datapass.project && viewItem =~ /^component.*\\.tool/",
          "group": "1_open@2"
        },
        {
          "command": "datapass.cloneRepository",
          "when": "view == datapass.project && viewItem =~ /^repo\\.(unbound|missing|wrong-remote)/",
          "group": "inline@1"
        },
        {
          "command": "datapass.locateRepository",
          "when": "view == datapass.project && viewItem =~ /^repo\\.(unbound|missing|wrong-remote|not-a-repo)/",
          "group": "inline@2"
        },
        {
          "command": "datapass.getUpdates",
          "when": "view == datapass.project && viewItem =~ /^repo\\.local\\.behind/",
          "group": "inline@1"
        },
        {
          "command": "datapass.checkForUpdates",
          "when": "view == datapass.project && viewItem =~ /^repo\\.local/",
          "group": "1_git@1"
        },
        {
          "command": "datapass.openRepositoryWindow",
          "when": "view == datapass.project && viewItem =~ /^repo\\.local/ && !(viewItem =~ /coordination/)",
          "group": "1_git@2"
        },
        {
          "command": "datapass.showPreflight",
          "when": "view == datapass.work && viewItem =~ /^operation/",
          "group": "inline"
        },
        {
          "command": "datapass.observeAppRevision",
          "when": "view == datapass.work && viewItem == app.remote",
          "group": "inline"
        },
        {
          "command": "datapass.approveBrief",
          "when": "view == datapass.work && viewItem == exchange.brief",
          "group": "inline"
        },
        {
          "command": "datapass.recordQualification",
          "when": "view == datapass.work && viewItem =~ /^operation/",
          "group": "inline"
        },
        {
          "command": "datapass.env.copyKeyName",
          "when": "view == datapass.project && viewItem =~ /^envKey/",
          "group": "inline"
        },
        {
          "command": "datapass.env.copyKeyName",
          "when": "view == datapass.project && viewItem =~ /^envKey/",
          "group": "1_env@1"
        },
        {
          "command": "datapass.env.copyIdentifier",
          "when": "view == datapass.project && viewItem == identifier",
          "group": "inline"
        },
        {
          "command": "datapass.env.openFile",
          "when": "view == datapass.project && viewItem == envFile",
          "group": "inline"
        }
