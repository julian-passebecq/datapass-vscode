    "configuration": {
      "title": "DataPass Control Plane",
      "properties": {
        "datapass.diagramCloud.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Where DiagramCloud runs (https://…, or http://localhost for a dev server). Opened by \"Open Architecture in DiagramCloud\"; no project data is ever put in the URL."
        },
        "datapass.mongoku.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Where your Mongoku runs (https://…, or http://localhost:3100 for a local server). Used for \"Open in Mongoku\"; DataPass appends only ?project=<entity id>. No credentials."
        },
        "datapass.foil.controlRoot": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Local path to foil-control-v1. Leave blank for workspace auto-detection."
        },
        "datapass.foil.databricksRoot": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Local path to foil_databrick_dab. Leave blank for workspace auto-detection."
        },
        "datapass.foil.oracleSshHost": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "SSH config host alias for the FOIL Oracle VM. Do not put credentials here."
        },
        "datapass.fabric.toolboxRoot": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional local clone of microsoft/fabric-toolbox or fabric-toolbox_J."
        },
        "datapass.grafana.generatorCommand": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Dashboard generator command used by gcx dev serve, for example: npm run generate:grafana."
        },
        "datapass.grafana.watchPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional path passed to gcx dev serve --watch."
        },
        "datapass.catalogs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Absolute paths of DataPass project catalogs (datapass.catalog JSON, e.g. <hub clone>/.datapass/catalog.json) listed by \"Switch Project\". A catalog lists projects and their coordination repositories; no credentials."
        },
        "datapass.projectsFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Absolute folders where you keep clones (e.g. D:\\PROJ). DataPass looks there, besides the project folder's parent, for the repositories a project declares, and checks each clone's Git origin."
        },
        "datapass.powerOps.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path of the Power Ops program (JUtilityPalette.exe) started by \"Open Power Ops\". Machine-level user setting: a workspace can never choose which program DataPass starts. Nothing is passed to it."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.datapass/project.json"
        ],
        "url": "./schemas/datapass-project.schema.json"
      },
      {
        "fileMatch": [
          "**/.datapass/graph.json"
        ],
        "url": "./schemas/datapass-graph.schema.json"
      },
      {
        "fileMatch": [
          "**/.datapass/claims.json"
        ],
        "url": "./schemas/datapass-claims-register.schema.json"
      },
      {
        "fileMatch": [
          "**/.datapass/packs/*.json",
          "**/resources/domain-packs/*.json"
        ],
        "url": "./schemas/datapass-domain-pack.schema.json"
      },
      {
        "fileMatch": [
          "**/.datapass/catalog.json"
        ],
        "url": "./schemas/datapass-catalog.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "datapass.project",
        "contents": "Open the folder (or repository) that holds your project's .datapass/project.json.\n[Open Folder](command:vscode.openFolder)\n[Switch Project…](command:datapass.switchProject)\n[How to prepare a project](command:datapass.openPreparationGuide)",
        "when": "workbenchState == empty"
      },
      {
        "view": "datapass.work",
        "contents": "Open a folder to plan and prepare DataPass work.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "package": "npm run verify && vsce package",
    "schemas": "tsx scripts/emit-schemas.ts",
    "test:desktop": "npm run build && tsx scripts/desktop-test.ts",
    "preview:galaxy": "tsx scripts/galaxy-preview.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julian-passebecq/datapass-vscode.git"
  },
  "homepage": "https://github.com/julian-passebecq/datapass-vscode",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode DataPass reads the project files but never runs Git or other programs inside the workspace: repository state is shown as not inspected, and Check for updates, Get updates, cloning and command operations are disabled until you trust the folder."
    }
  }
}
