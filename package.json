{
  "name": "datapass-vscode",
  "displayName": "DataPass Control Plane",
  "description": "VS Code workbench for AI-prepared cloud projects: see the architecture, the files each step needs in which repository, what is missing, and open the right file or official tool (Fabric, Databricks, Azure Data Factory, Functions, Cosmos DB, MongoDB, PostgreSQL, Power BI, Grafana, IaC).",
  "version": "0.14.0",
  "publisher": "julian-passebecq",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "onView:datapass.project",
    "onView:datapass.work",
    "onView:datapass.galaxy",
    "onView:datapass.architecture",
    "onView:datapass.details",
    "workspaceContains:.datapass/project.json",
    "workspaceContains:.datapass/catalog.json",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "datapass.refresh",
        "title": "DataPass: Refresh Control Plane",
        "icon": "$(refresh)"
      },
      {
        "command": "datapass.openGalaxy",
        "title": "DataPass: Open Galaxy"
      },
      {
        "command": "datapass.selectFoilControlRoot",
        "title": "DataPass: Select FOIL Control Repository"
      },
      {
        "command": "datapass.selectFoilDatabricksRoot",
        "title": "DataPass: Select FOIL Databricks Repository"
      },
      {
        "command": "datapass.initializeProjectManifest",
        "title": "DataPass: Initialize Project Manifest"
      },
      {
        "command": "datapass.initializeFoilProjectManifest",
        "title": "DataPass: Initialize FOIL Project Manifest"
      },
      {
        "command": "datapass.openProjectManifest",
        "title": "DataPass: Open Project Manifest"
      },
      {
        "command": "datapass.copyEnvironmentSnapshot",
        "title": "DataPass: Copy Environment Snapshot"
      },
      {
