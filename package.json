    "viewsContainers": {
      "activitybar": [
        {
          "id": "datapass",
          "title": "DataPass",
          "icon": "resources/datapass.svg"
        }
      ],
      "panel": [
        {
          "id": "datapass-architecture",
          "title": "DataPass Architecture",
          "icon": "resources/datapass.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "datapass-details",
          "title": "DataPass Details",
          "icon": "resources/datapass.svg"
        }
      ]
    },
    "views": {
      "datapass": [
        {
          "id": "datapass.project",
          "name": "Project",
          "type": "tree"
        },
        {
          "id": "datapass.work",
          "name": "Work",
          "type": "tree",
          "visibility": "collapsed"
        },
        {
          "id": "datapass.galaxy",
          "name": "Galaxy",
          "type": "webview",
          "visibility": "collapsed"
        }
      ],
      "datapass-architecture": [
        {
          "id": "datapass.architecture",
          "name": "Architecture",
          "type": "webview"
        }
      ],
      "datapass-details": [
        {
          "id": "datapass.details",
          "name": "Details",
          "type": "webview"
        }
      ]
    },
