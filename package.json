      "commandPalette": [
        {
          "command": "datapass.setChecklistState",
          "when": "false"
        },
        {
          "command": "datapass.openExchange",
          "when": "false"
        },
        {
          "command": "datapass.selectComponent",
          "when": "false"
        },
        {
          "command": "datapass.openComponentFile",
          "when": "false"
        },
        {
          "command": "datapass.explainMissingFile",
          "when": "false"
        },
        {
          "command": "datapass.setProjectChecklist",
          "when": "false"
        },
        {
          "command": "datapass.openDoc",
          "when": "false"
        },
        {
          "command": "datapass.installTool",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "datapass.validateContract",
          "when": "resourceExtname == .json && resourcePath =~ /\\.datapass/",
          "group": "7_datapass"
        }
      ]
