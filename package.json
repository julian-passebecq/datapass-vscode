{
  "name": "datapass-vscode",
  "displayName": "DataPass Control Plane",
  "description": "VS Code control plane for Fabric, Databricks, Power BI, Grafana and infrastructure: work scopes, operation preflight, contracted app exchanges, impact analysis and publication briefs.",
  "version": "0.9.2",
  "publisher": "julian-passebecq",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "onView:datapass.galaxy",
    "onView:datapass.work",
    "workspaceContains:.datapass/project.json",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "datapass.refresh",
        "title": "DataPass: Refresh Control Plane",
        "icon": "$(refresh)"
      },
      {
        "command": "datapass.openGalaxy",
        "title": "DataPass: Open Galaxy"
      },
      {
        "command": "datapass.selectFoilControlRoot",
        "title": "DataPass: Select FOIL Control Repository"
      },
      {
        "command": "datapass.selectFoilDatabricksRoot",
        "title": "DataPass: Select FOIL Databricks Repository"
      },
      {
        "command": "datapass.initializeProjectManifest",
        "title": "DataPass: Initialize Project Manifest"
      },
      {
        "command": "datapass.initializeFoilProjectManifest",
        "title": "DataPass: Initialize FOIL Project Manifest"
      },
      {
        "command": "datapass.openProjectManifest",
        "title": "DataPass: Open Project Manifest"
      },
      {
        "command": "datapass.copyEnvironmentSnapshot",
        "title": "DataPass: Copy Environment Snapshot"
      },
      {
        "command": "datapass.fabric.captureSummary",
        "title": "DataPass: Fabric Capture Environment Summary"
      },
      {
        "command": "datapass.fabric.scaffoldDeployConfig",
        "title": "DataPass: Fabric Scaffold Deploy Config"
      },
      {
        "command": "datapass.fabric.copyDeployCommand",
        "title": "DataPass: Fabric Copy Deploy Command"
      },
      {
        "command": "datapass.fabric.scaffoldPreflightWorkflow",
        "title": "DataPass: Fabric Scaffold CI Preflight"
      },
      {
        "command": "datapass.work.refresh",
        "title": "DataPass: Refresh Work View (re-probe tools)",
        "icon": "$(refresh)"
      },
      {
        "command": "datapass.selectScope",
        "title": "DataPass: Select Work Scope",
        "icon": "$(target)"
      },
      {
        "command": "datapass.setChecklistState",
        "title": "DataPass: Set Checklist Item State"
      },
      {
        "command": "datapass.showPreflight",
        "title": "DataPass: Show Operation Preflight",
        "icon": "$(tools)"
      },
      {
        "command": "datapass.createAppRequest",
        "title": "DataPass: Create External App Request",
        "icon": "$(arrow-up)"
      },
      {
        "command": "datapass.importAppResult",
        "title": "DataPass: Import External App Result",
        "icon": "$(arrow-down)"
      },
      {
        "command": "datapass.observeAppRevision",
        "title": "DataPass: Observe App Remote Revision",
        "icon": "$(git-commit)"
      },
      {
        "command": "datapass.createCandidate",
        "title": "DataPass: Create Parameter Candidate"
      },
      {
        "command": "datapass.analyzeImpact",
        "title": "DataPass: Analyze Output Impact"
      },
      {
        "command": "datapass.prepareBrief",
        "title": "DataPass: Prepare Publication Brief"
      },
      {
        "command": "datapass.approveBrief",
        "title": "DataPass: Approve Brief for Generation",
        "icon": "$(verified)"
      },
      {
        "command": "datapass.importOutputManifest",
        "title": "DataPass: Import Publication Output Manifest"
      },
      {
        "command": "datapass.importAuthoritySnapshot",
        "title": "DataPass: Import Authority Snapshot"
      },
      {
        "command": "datapass.exportDiagramCloud",
        "title": "DataPass: Export DiagramCloud Projection"
      },
      {
        "command": "datapass.inspectPowerBiProject",
        "title": "DataPass: Inspect Power BI Project (PBIP/PBIR/TMDL)"
      },
      {
        "command": "datapass.copyAiContext",
        "title": "DataPass: Copy AI Context…",
        "icon": "$(copy)"
      },
      {
        "command": "datapass.diagramCloud.openArchitecture",
        "title": "DataPass: Open Architecture in DiagramCloud"
      },
      {
        "command": "datapass.diagramCloud.copyAiContext",
        "title": "DataPass: Copy DiagramCloud AI Context (JSON)…"
      },
      {
        "command": "datapass.diagramCloud.importAiPlan",
        "title": "DataPass: Import DiagramCloud AI Plan…"
      },
      {
        "command": "datapass.diagramCloud.copySummary",
        "title": "DataPass: Copy Project/Scope Summary"
      },
      {
        "command": "datapass.migrateManifestToV2",
        "title": "DataPass: Upgrade Project Manifest to v2"
      },
      {
        "command": "datapass.initGraph",
        "title": "DataPass: Initialize Project Graph"
      },
      {
        "command": "datapass.validateContract",
        "title": "DataPass: Validate DataPass JSON (contract/pack/graph/claims)"
      },
      {
        "command": "datapass.openExchange",
        "title": "DataPass: Open Exchange File"
      },
      {
        "command": "datapass.openCompanionLink",
        "title": "DataPass: Open Companion Link (Grafana, Mongoku)…",
        "icon": "$(link-external)"
      },
      {
        "command": "datapass.mongoku.importContext",
        "title": "DataPass: Import Mongoku Context…"
      },
      {
        "command": "datapass.mongoku.setUrl",
        "title": "DataPass: Set Mongoku Address…"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "datapass",
          "title": "DataPass",
          "icon": "resources/datapass.svg"
        }
      ]
    },
    "views": {
      "datapass": [
        {
          "id": "datapass.work",
          "name": "Work",
          "type": "tree"
        },
        {
          "id": "datapass.galaxy",
          "name": "Galaxy",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "datapass.refresh",
          "when": "view == datapass.galaxy",
          "group": "navigation@1"
        },
        {
          "command": "datapass.selectScope",
          "when": "view == datapass.work",
          "group": "navigation@1"
        },
        {
          "command": "datapass.copyAiContext",
          "when": "view == datapass.work",
          "group": "navigation@2"
        },
        {
          "command": "datapass.work.refresh",
          "when": "view == datapass.work",
          "group": "navigation@3"
        },
        {
          "command": "datapass.createAppRequest",
          "when": "view == datapass.work",
          "group": "1_exchange@1"
        },
        {
          "command": "datapass.importAppResult",
          "when": "view == datapass.work",
          "group": "1_exchange@2"
        },
        {
          "command": "datapass.createCandidate",
          "when": "view == datapass.work",
          "group": "2_model@1"
        },
        {
          "command": "datapass.analyzeImpact",
          "when": "view == datapass.work",
          "group": "2_model@2"
        },
        {
          "command": "datapass.prepareBrief",
          "when": "view == datapass.work",
          "group": "3_publish@1"
        },
        {
          "command": "datapass.importOutputManifest",
          "when": "view == datapass.work",
          "group": "3_publish@2"
        },
        {
          "command": "datapass.importAuthoritySnapshot",
          "when": "view == datapass.work",
          "group": "4_context@1"
        },
        {
          "command": "datapass.exportDiagramCloud",
          "when": "view == datapass.work",
          "group": "4_context@2"
        },
        {
          "command": "datapass.inspectPowerBiProject",
          "when": "view == datapass.work",
          "group": "4_context@3"
        },
        {
          "command": "datapass.initGraph",
          "when": "view == datapass.work",
          "group": "5_project@1"
        },
        {
          "command": "datapass.migrateManifestToV2",
          "when": "view == datapass.work",
          "group": "5_project@2"
        },
        {
          "command": "datapass.diagramCloud.openArchitecture",
          "when": "view == datapass.work",
          "group": "6_diagramcloud@1"
        },
        {
          "command": "datapass.diagramCloud.copyAiContext",
          "when": "view == datapass.work",
          "group": "6_diagramcloud@2"
        },
        {
          "command": "datapass.diagramCloud.importAiPlan",
          "when": "view == datapass.work",
          "group": "6_diagramcloud@3"
        },
        {
          "command": "datapass.diagramCloud.copySummary",
          "when": "view == datapass.work",
          "group": "6_diagramcloud@4"
        },
        {
          "command": "datapass.openCompanionLink",
          "when": "view == datapass.work",
          "group": "7_companions@1"
        },
        {
          "command": "datapass.mongoku.importContext",
          "when": "view == datapass.work",
          "group": "7_companions@2"
        }
      ],
      "view/item/context": [
        {
          "command": "datapass.showPreflight",
          "when": "view == datapass.work && viewItem =~ /^operation/",
          "group": "inline"
        },
        {
          "command": "datapass.observeAppRevision",
          "when": "view == datapass.work && viewItem == app.remote",
          "group": "inline"
        },
        {
          "command": "datapass.approveBrief",
          "when": "view == datapass.work && viewItem == exchange.brief",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "datapass.setChecklistState",
          "when": "false"
        },
        {
          "command": "datapass.openExchange",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "datapass.validateContract",
          "when": "resourceExtname == .json && resourcePath =~ /\\.datapass/",
          "group": "7_datapass"
        }
      ]
    },
    "configuration": {
      "title": "DataPass Control Plane",
      "properties": {
        "datapass.diagramCloud.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Where DiagramCloud runs (https://…, or http://localhost for a dev server). Opened by \"Open Architecture in DiagramCloud\"; no project data is ever put in the URL."
        },
        "datapass.mongoku.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Where your Mongoku runs (https://…, or http://localhost:3100 for a local server). Used for \"Open in Mongoku\"; DataPass appends only ?project=<entity id>. No credentials."
        },
        "datapass.foil.controlRoot": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Local path to foil-control-v1. Leave blank for workspace auto-detection."
        },
        "datapass.foil.databricksRoot": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Local path to foil_databrick_dab. Leave blank for workspace auto-detection."
        },
        "datapass.foil.oracleSshHost": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "SSH config host alias for the FOIL Oracle VM. Do not put credentials here."
        },
        "datapass.fabric.toolboxRoot": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional local clone of microsoft/fabric-toolbox or fabric-toolbox_J."
        },
        "datapass.grafana.generatorCommand": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Dashboard generator command used by gcx dev serve, for example: npm run generate:grafana."
        },
        "datapass.grafana.watchPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional path passed to gcx dev serve --watch."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.datapass/project.json"
        ],
        "url": "./schemas/datapass-project.schema.json"
      },
      {
        "fileMatch": [
          "**/.datapass/graph.json"
        ],
        "url": "./schemas/datapass-graph.schema.json"
      },
      {
        "fileMatch": [
          "**/.datapass/claims.json"
        ],
        "url": "./schemas/datapass-claims-register.schema.json"
      },
      {
        "fileMatch": [
          "**/.datapass/packs/*.json",
          "**/resources/domain-packs/*.json"
        ],
        "url": "./schemas/datapass-domain-pack.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "datapass.work",
        "contents": "Open a folder to plan and prepare DataPass work.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "package": "npm run verify && vsce package",
    "schemas": "tsx scripts/emit-schemas.ts",
    "test:desktop": "npm run build && tsx scripts/desktop-test.ts",
    "preview:galaxy": "tsx scripts/galaxy-preview.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julian-passebecq/datapass-vscode.git"
  },
  "homepage": "https://github.com/julian-passebecq/datapass-vscode"
}
