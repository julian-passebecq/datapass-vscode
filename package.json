      },
      {
        "command": "datapass.setProjectChecklist",
        "title": "DataPass: Set a Checklist Item State"
      },
      {
        "command": "datapass.openDoc",
        "title": "DataPass: Open a Project Document"
      },
      {
        "command": "datapass.env.copyKeyName",
