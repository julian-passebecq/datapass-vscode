        "icon": "$(checklist)"
      },
      {
        "command": "datapass.exportQualificationReport",
        "title": "DataPass: Export Qualification Report",
        "icon": "$(report)"
      },
      {
        "command": "datapass.clearQualificationResults",
        "title": "DataPass: Clear Qualification Results"
      },
      {
        "command": "datapass.openWorkbench",
        "title": "DataPass: Open Project Workbench",
        "icon": "$(layout)"
      },
      {
        "command": "datapass.arrangeWorkbench",
