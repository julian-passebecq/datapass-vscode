        "icon": "$(copy)"
      },
      {
        "command": "datapass.env.openFile",
        "title": "DataPass: Open Env File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "datapass.env.copyIdentifier",
        "title": "DataPass: Copy Non-secret Identifier",
        "icon": "$(copy)"
      },
      {
        "command": "datapass.copyProjectId",
        "title": "DataPass: Copy Project ID"
      },
      {
        "command": "datapass.openPowerOps",
        "title": "DataPass: Open Power Ops (local vault)",
        "icon": "$(lock)"
      },
      {
        "command": "datapass.readinessReport",
        "title": "DataPass: Show Readiness Report (env files, variables, companions, repositories)",
        "icon": "$(checklist)"
