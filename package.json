      {
        "command": "datapass.selectProjectFolder",
        "title": "DataPass: Choose the Project Folder of this Window…",
        "icon": "$(root-folder)"
      },
      {
        "command": "datapass.switchProject",
        "title": "DataPass: Switch Project…",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "datapass.selectComponent",
        "title": "DataPass: Select a Component"
      },
      {
        "command": "datapass.openComponentFile",
        "title": "DataPass: Open a Component File"
      },
      {
        "command": "datapass.explainMissingFile",
