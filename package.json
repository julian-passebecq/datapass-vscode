        "icon": "$(repo-clone)"
      },
      {
        "command": "datapass.locateRepository",
        "title": "DataPass: Locate an Existing Clone…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "datapass.openRepositoryWindow",
        "title": "DataPass: Open a Project Repository in a New Window…",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "datapass.openComponentFolder",
        "title": "DataPass: Open the Component Folder in a New Window",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "datapass.openComponentEntry",
        "title": "DataPass: Open the Component's Entry File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "datapass.openNativeTool",
        "title": "DataPass: Open the Component's Official Tool",
        "icon": "$(tools)"
      },
      {
        "command": "datapass.openAdfStudio",
        "title": "DataPass: Open Azure Data Factory Studio",
        "icon": "$(link-external)"
      },
      {
        "command": "datapass.showOperation",
        "title": "DataPass: Show a Component Operation (prerequisites, reviews)…",
        "icon": "$(checklist)"
      },
      {
        "command": "datapass.copyComponentCommand",
        "title": "DataPass: Copy a Component Command…",
        "icon": "$(terminal)"
      },
      {
        "command": "datapass.recordComponentResult",
        "title": "DataPass: Record a Component Operation Result…",
        "icon": "$(pass)"
      },
      {
        "command": "datapass.installTool",
        "title": "DataPass: Show an Official Extension",
        "icon": "$(extensions)"
      },
      {
        "command": "datapass.openGraph",
        "title": "DataPass: Open Project Graph (graph.json)",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "datapass.openPreparationGuide",
        "title": "DataPass: Open the Project Preparation Guide (for you and your AI)",
        "icon": "$(book)"
      },
      {
        "command": "datapass.upgradeManifest",
